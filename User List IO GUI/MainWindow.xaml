<Window x:Class="User_List_IO_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="800">
    <Grid x:Name="MainGrid">
        <Button Content="Process the file and send manager approval emails." HorizontalAlignment="Left"
                VerticalAlignment="Center" Width="355" Click="ProcessFileButton_Click" Margin="24,0,0,0" Height="200" />
        <Button Content="Create a 30/60/90 Last Login Report in PDF format." HorizontalAlignment="Left"
                VerticalAlignment="Top" Width="355" Click="ProcessFileButton_Click" Margin="413,87,0,0" Height="100" />
        <Button Content="Create an XLS Sheet used to verify the return of approval emails." HorizontalAlignment="Left"
                VerticalAlignment="Top" Width="355" Click="ProcessFileButton_Click" Margin="413,192,0,0" Height="100" />
    </Grid>
</Window>