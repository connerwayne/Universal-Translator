<Window x:Class="User_List_IO_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:User_List_IO_GUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Button Content="Step 1: Import File. This is the user list from the system vendor." HorizontalAlignment="Left" VerticalAlignment="Top" Width="375" Click="ImportFileButton_Click" Height="200" Margin="25,17,0,0" />
        <Button Content="Step 2: Process the file and send manager approval emails." HorizontalAlignment="Left" VerticalAlignment="Top" Width="375" Click="ProcessFileButton_Click" Margin="25,217,0,0" Height="200"/>
        <Button Content="Create a 30/60/90 Last Login Report in PDF format." HorizontalAlignment="Left" VerticalAlignment="Top" Width="375" Click="ProcessFileButton_Click" Margin="400,17,0,0" Height="200"/>
        <Button Content="Create an XLS Sheet used to verify the return of approval emails." HorizontalAlignment="Left" VerticalAlignment="Top" Width="375" Click="ProcessFileButton_Click" Margin="400,217,0,0" Height="200"/>
    </Grid>
</Window>
