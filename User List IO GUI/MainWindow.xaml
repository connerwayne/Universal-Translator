<Window x:Class="AuditTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        Title="Audit Tool - Universal Translator" Height="350" Width="525">
    <Window.Resources>
        <Storyboard x:Key="ProgressBarAnimation">
            <DoubleAnimation Storyboard.TargetName="progressBar"
                             Storyboard.TargetProperty="Value"
                             From="0" To="100" Duration="0:0:5"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>
    <Grid Margin="10">
        <!--<Grid.Background>
            <ImageBrush ImageSource="C:\Temp\AuditTool\Background.jpg" />
        </Grid.Background>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Grid.ColumnSpan="2" Text="Audit Tool - Universal Translator" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Process File Button -->
        <Button Grid.Row="1" Content="Process User List File" Click="ProcessFileButton_Click" Width="150" Height="50" Margin="180,95,175,96" ToolTip="Click to process your vendors user list file, generate a report, and send access approval emails to managers." Grid.ColumnSpan="2"/>

        <!-- Rocket --><!--
        <Image Grid.Row="2" Grid.ColumnSpan="2" Name="rocket" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
               wpfAnimatedGif:ImageBehavior.AnimatedSource="C:\Temp\AuditTool\Rocket.gif"/>-->

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Name="progressBar" Height="20" Margin="10" Visibility="Collapsed" Panel.ZIndex="1" VerticalAlignment="Bottom"/>

        <!-- Status Text -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Name="statusText" HorizontalAlignment="Center" Margin="10"/>
    </Grid>
</Window>